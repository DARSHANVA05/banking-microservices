pipeline {
    agent none

    environment {
        APP_DIR = "Main/Main"  // Path to your Spring Boot orchestrator app
    }

    stages {

        stage('Checkout') {
            agent { label 'bm-orchestrator-build' }
            steps {
                echo "Checking out Banking Microservices repo..."
                checkout scm
            }
        }

        stage('Build Orchestrator App') {
            agent { label 'bm-orchestrator-build' }
            steps {
                echo "Building Orchestrator Spring Boot application..."
                dir("${APP_DIR}") {
                    bat 'mvn clean compile'
                }
            }
        }

        stage('Test Orchestrator App') {
            agent { label 'bm-orchestrator-test' }
            steps {
                echo "Running tests for Orchestrator Spring Boot application..."
                dir("${APP_DIR}") {
                    bat 'mvn test'
                }
            }
            post {
                always {
                    dir("${APP_DIR}") {
                        junit 'target/surefire-reports/*.xml'
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Build & tests successful. Triggering SonarQube pipeline..."
            //build job: 'bm-orchestrator-sonarqube', wait: false
        }

        failure {
            echo "Build or tests failed. SonarQube will NOT run."
        }
    }
}
