pipeline {
    agent { label 'bm-orchestrator-sonarqube' }

    environment {
        APP_DIR = "Main/Main"  // Path to Spring Boot app
        SONAR_HOST_URL = "http://localhost:9000"  // SonarQube server URL
        SONAR_PROJECT_KEY = "banking-microservice-orchestrator"
        SONAR_PROJECT_NAME = "Banking Microservice Orchestrator"
        SONAR_PROJECT_VERSION = "1.0"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Checking out repo for Sonar analysis..."
                checkout scm
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo "Running SonarQube analysis..."
                dir("${APP_DIR}") {
                    // Inject token from Jenkins Credentials securely
                    withCredentials([string(credentialsId: 'SONAR_TOKEN', variable: 'SONAR_TOKEN')]) {
                        bat """
                            mvn sonar:sonar ^
                            -Dsonar.projectKey=${SONAR_PROJECT_KEY} ^
                            -Dsonar.projectName="${SONAR_PROJECT_NAME}" ^
                            -Dsonar.projectVersion=${SONAR_PROJECT_VERSION} ^
                            -Dsonar.host.url=${SONAR_HOST_URL} ^
                            -Dsonar.login=${SONAR_TOKEN}
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo "Waiting for SonarQube Quality Gate..."
                timeout(time: 5, unit: 'MINUTES') { // Increase timeout if analysis is large
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        success {
            echo "✅ SonarQube Quality Gate PASSED"
        }
        failure {
            echo "❌ SonarQube Quality Gate FAILED"
        }
    }
}
